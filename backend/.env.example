APP_NAME="Nexus Flow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this API (production: https://api.example.com)
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (MySQL 8 in dev/prod; tests use in-memory SQLite) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexus_flow
DB_USERNAME=nexus
DB_PASSWORD=

# --- Frontend / SPA auth ---
# Frontend origin(s), comma-separated. Used for CORS and OAuth redirects.
# Production: https://app.example.com
FRONTEND_URL=http://localhost:3000
# Host(s) (no scheme) that receive Sanctum session cookies.
# Production: app.example.com
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Sessions: production must use SESSION_DOMAIN=.example.com and SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Comma-separated Google account emails that become platform admins.
ADMIN_EMAILS=

# --- Google OAuth (Google Cloud Console → Credentials → OAuth client ID, type "Web application") ---
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Private document storage (S3-compatible in production) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
