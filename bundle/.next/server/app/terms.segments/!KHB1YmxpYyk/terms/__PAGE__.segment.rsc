0:{"buildId":"MGTfyB4xdenuAaBUFw4sC","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"className":"mx-auto max-w-3xl px-4 py-8 sm:py-12","children":[["$","h1",null,{"className":"text-3xl font-bold text-slate-900","children":"Terms of Service"}],["$","p",null,{"className":"mt-1 text-sm text-slate-500","children":["Last updated: ","4 October 2026"]}],["$","div",null,{"className":"prose-simple mt-6","children":[["$","p",null,{"children":["These Terms of Service (“Terms”) govern your access to and use of the NexusFlow portal at"," ",["$","a",null,{"href":"https://nexusflowservices.com","children":"nexusflowservices.com"}]," and its related overseas recruitment and MBBS admission services (the “Service”), operated by NexusFlow Services LLP, a Limited Liability Partnership with its registered office at Door No 13/227, Kakkoor, Piravom, Muvattupuzha, Ernakulam, Kerala, India – 686662. By signing in to or using the Service, you agree to these Terms. If you do not agree, please do not use the Service."]}],["$","h2",null,{"children":"1. Who can use the Service"}],["$","p",null,{"children":"The Service is intended for genuine job seekers, students seeking overseas MBBS admission, and genuine employers. You must be at least 18 years old and able to form a binding agreement to use the Service. The Service is not intended for and may not be used by anyone under 18."}],["$","h2",null,{"children":"2. Our role"}],["$","p",null,{"children":"NexusFlow Services LLP acts as a facilitator that connects candidates and students with employers and universities abroad, including in Russia, Israel, Vietnam and Uzbekistan. We assist with applications and documentation, but admission and hiring decisions are made solely by the relevant university or employer. We do not guarantee any job offer, admission, visa, or placement."}],["$","h2",null,{"children":"3. Your account"}],["$","p",null,{"children":"You sign in with your Google account. You are responsible for keeping your account secure and for all activity under it. You agree to provide accurate, current and complete information and to keep it up to date. We may suspend or close accounts that contain false information or that misuse the Service."}],["$","h2",null,{"children":"4. Candidates and students"}],["$","ul",null,{"children":[["$","li",null,{"children":"You confirm that the documents and information you upload — including academic records for MBBS admission — are your own, genuine, lawful and up to date."}],["$","li",null,{"children":"You authorise us to share the documents required for a specific application with the relevant employer or university on your behalf."}],["$","li",null,{"children":"You are responsible for the content of your profile and the documents you choose to share."}],["$","li",null,{"children":"Applying through the Service does not guarantee a response, an interview, a job, an admission or a visa."}]]}],["$","h2",null,{"children":"5. Employers"}],["$","ul",null,{"children":[["$","li",null,{"children":"Employer accounts must be approved by our team before you can post jobs."}],["$","li",null,{"children":"Job posts must be genuine, lawful and non-discriminatory. You must not post misleading roles, request unlawful payment from candidates, or use the Service to collect data for any purpose other than genuine hiring."}],["$","li",null,{"children":"You may view only the profiles and resumes of candidates who apply to your own job posts, and you must use that information solely for recruitment. We may hide or remove any post that breaches these Terms."}]]}],["$","h2",null,{"children":"6. Acceptable use"}],["$","p",null,{"children":"You agree not to:"}],"$L2","$L3","$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12"]}]]}],null,"$L13"]}],"isPartial":"$@14","staleTime":"$15","varyParams":null},{"rsc":"$L16","isPartial":"$@17","staleTime":"$15","varyParams":null},{"rsc":"$L18","isPartial":"$@19","staleTime":"$15","varyParams":"$1a"