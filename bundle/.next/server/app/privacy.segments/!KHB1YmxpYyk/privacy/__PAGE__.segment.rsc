0:{"buildId":"MGTfyB4xdenuAaBUFw4sC","data":[{"rsc":["$","$1","c",{"children":[["$","article",null,{"className":"mx-auto max-w-3xl px-4 py-8 sm:py-12","children":[["$","h1",null,{"className":"text-3xl font-bold text-slate-900","children":"Privacy Policy"}],["$","p",null,{"className":"mt-1 text-sm text-slate-500","children":["Last updated: ","4 October 2026"]}],["$","div",null,{"className":"prose-simple mt-6","children":[["$","p",null,{"children":["This Privacy Policy explains how NexusFlow Services LLP (“NexusFlow”, “we”, “us” or “our”), a Limited Liability Partnership registered in Kerala, India, collects, uses, stores, shares and protects your personal information when you use our website at"," ",["$","a",null,{"href":"https://nexusflowservices.com","children":"nexusflowservices.com"}]," and our overseas recruitment and MBBS admission services (together, the “Service”). By signing in to and using the Service, you agree to the practices described here."]}],["$","h2",null,{"children":"1. Who we are and how to reach us"}],["$","p",null,{"children":["NexusFlow Services LLP operates an overseas recruitment and MBBS admission portal that connects candidates and students in India with employers and universities abroad, including in Russia, Israel, Vietnam and Uzbekistan. Our registered office is Door No 13/227, Kakkoor, Piravom, Muvattupuzha, Ernakulam, Kerala, India – 686662. For any question about this policy or your personal information, contact us at"," ",["$","a",null,{"href":"mailto:anishvcare@gmail.com","children":"anishvcare@gmail.com"}],"."]}],["$","h2",null,{"children":"2. Information we collect"}],["$","p",null,{"children":"We collect only the information needed to provide our services:"}],["$","h3",null,{"children":"Information you give us when you sign in"}],["$","ul",null,{"children":["$","li",null,{"children":[["$","strong",null,{"children":"Google account details."}]," Sign-in is through Google. When you sign in we receive your name, email address and profile picture from your Google account. We do not receive or store your Google password."]}]}],["$","h3",null,{"children":"Information you add to your profile or application"}],["$","ul",null,{"children":[["$","li",null,{"children":"Profile and application details such as your date of birth, gender, contact number, address, preferred trades or courses, preferred countries, education and work experience."}],["$","li",null,{"children":"Documents you choose to upload, such as your photograph, CV/resume, Aadhaar card, SSLC book, academic transcripts and mark sheets, education and skill certificates, experience certificates and passport pages, as relevant to recruitment or MBBS admission."}],["$","li",null,{"children":"For employers: your company name, contact details and the job posts you create."}]]}],["$","h3",null,{"children":"Information we collect automatically"}],["$","ul",null,{"children":["$","li",null,{"children":"Basic technical data such as your IP address, browser type and the pages you visit, used to keep the Service secure and working. A session cookie keeps you signed in; we do not use advertising or tracking cookies."}]}],["$","h2",null,{"children":"3. How we use your information"}],["$","ul",null,{"children":[["$","li",null,{"children":"To create and manage your account and sign you in securely."}],["$","li",null,{"children":"To build your candidate or student profile and professional resume, and to let you apply to jobs or MBBS admissions."}],["$","li",null,{"children":"To process and support your overseas recruitment or university admission applications, including sharing required documents with the relevant employer or university on your behalf."}],["$","li",null,{"children":"To let approved employers review applicants to their own job posts, and to let our admin team operate the platform."}],"$L2","$L3"]}],"$L4","$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14"]}]]}],null,"$L15"]}],"isPartial":"$@16"