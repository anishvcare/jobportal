6:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"You."}]," You can view and update your profile and documents at any time."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Employers and universities you apply to."}]," When you apply to a job or an MBBS admission, we share the profile, resume and documents required for that specific application with the relevant employer or university, with your consent."]}],["$","li",null,{"children":[["$","strong",null,{"children":"The NexusFlow admin team."}]," Our admins can review candidate and student records and documents in order to process applications and help employers and universities. Every document download is recorded in an audit log."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Service providers."}]," We use trusted providers for hosting and file storage. They process data only to provide those services to us."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Legal reasons."}]," We may disclose information if required by law or to protect the rights, safety and security of our users and the Service."]}]]}]
7:["$","h2",null,{"children":"5. How we store and protect your information"}]
8:["$","p",null,{"children":"Your documents are stored privately and are not publicly accessible. We apply reasonable technical and organisational measures to protect your information, including encrypted session cookies and access controls that limit who can view documents. No method of transmission or storage is completely secure, but we work to protect your data."}]
9:["$","h2",null,{"children":"6. How long we keep your information"}]
a:["$","p",null,{"children":"We keep your information for as long as your account is active and as needed to provide our recruitment and admission services. If you delete your account, we immediately and permanently delete your profile, uploaded files, applications and generated packs. For security and audit purposes we retain only limited log records (such as an internal account identifier), which do not include your documents."}]
b:["$","h2",null,{"children":"7. Your choices and rights"}]
c:["$","ul",null,{"children":[["$","li",null,{"children":"You can update or correct your profile information at any time."}],["$","li",null,{"children":"You can delete your account and all your documents from your account settings. This takes effect immediately."}],["$","li",null,{"children":["You can ask us about the information we hold about you by emailing"," ",["$","a",null,{"href":"mailto:anishvcare@gmail.com","children":"anishvcare@gmail.com"}],"."]}]]}]
d:["$","h2",null,{"children":"8. Google user data"}]
e:["$","p",null,{"children":"NexusFlow’s use of information received from Google APIs follows the Google API Services User Data Policy, including its Limited Use requirements. We request only your basic profile information (name, email address and profile picture) to create your account and sign you in. We do not use this data for advertising and we do not transfer it to others except as described in this policy."}]
f:["$","h2",null,{"children":"9. Age requirement"}]
10:["$","p",null,{"children":"The Service is intended only for adults aged 18 years or older. We do not knowingly collect personal information from anyone under 18. If you believe a person under 18 has provided us with information, contact us and we will delete it promptly."}]
11:["$","h2",null,{"children":"10. Changes to this policy"}]
12:["$","p",null,{"children":"We may update this policy from time to time. When we do, we will revise the “Last updated” date above. Significant changes will be communicated through the Service."}]
13:["$","h2",null,{"children":"11. Contact"}]
